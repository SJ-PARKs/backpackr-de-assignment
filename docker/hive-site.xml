<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>

  <!-- ── PostgreSQL Metastore 연결 ──────────────────────────────────────── -->
  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:postgresql://postgres/metastore</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionDriverName</name>
    <value>org.postgresql.Driver</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionUserName</name>
    <value>hive</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionPassword</name>
    <value>hive</value>
  </property>

  <!-- ── Metastore 서비스 URI ───────────────────────────────────────────── -->
  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://hive-metastore:9083</value>
  </property>
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>hdfs://namenode:9000/user/hive/warehouse</value>
  </property>

  <!-- ── DataNucleus 스키마 자동 생성 ──────────────────────────────────── -->
  <property>
    <name>datanucleus.autoCreateSchema</name>
    <value>true</value>
  </property>
  <!-- DataNucleus 4.x 이후 명칭 변경: 이 속성이 없으면 DBS 테이블 없다고 에러 발생 -->
  <property>
    <name>datanucleus.schema.autoCreateTables</name>
    <value>true</value>
  </property>
  <property>
    <name>datanucleus.fixedDatastore</name>
    <value>false</value>
  </property>
  <property>
    <name>datanucleus.autoStartMechanism</name>
    <value>SchemaTable</value>
  </property>
  <!-- 스키마 버전 검증 비활성화 (이미지 간 버전 불일치 방지) -->
  <property>
    <name>hive.metastore.schema.verification</name>
    <value>false</value>
  </property>

  <!-- ── 동적 파티션 ────────────────────────────────────────────────────── -->
  <property>
    <name>hive.exec.dynamic.partition</name>
    <value>true</value>
  </property>
  <property>
    <name>hive.exec.dynamic.partition.mode</name>
    <value>nonstrict</value>
  </property>

  <!-- ── 통계 수집 ──────────────────────────────────────────────────────── -->
  <property>
    <name>hive.stats.autogather</name>
    <value>true</value>
  </property>

  <!-- ── 인증 비활성화 (로컬 개발 환경) ───────────────────────────────── -->
  <property>
    <name>hive.metastore.event.db.notification.api.auth</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.server2.authentication</name>
    <value>NONE</value>
  </property>
  <!-- doAs=false: root 유저가 anonymous 를 impersonate 하려다 발생하는 AuthorizationException 방지 -->
  <property>
    <name>hive.server2.enable.doAs</name>
    <value>false</value>
  </property>

  <!-- ── 실행 엔진 ──────────────────────────────────────────────────────── -->
  <property>
    <name>hive.execution.engine</name>
    <value>mr</value>
  </property>

</configuration>
